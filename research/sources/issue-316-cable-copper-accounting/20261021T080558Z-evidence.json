  "claim_assessments": [
    {
      "id": "version",
      "locators": [
        "PDF pp1–9, Article in Press header",
        "ORBi Files",
        "Elsevier coredata XML"
      ],
      "assessment": "Current PDF remains the same nine-page article-in-press postprint; final pagination is metadata only. No final typeset body, raw curves or SI acquired."
    },
    {
      "id": "figure-map",
      "locators": [
        "p5 Fig6",
        "p6 Figs8–10",
        "p7 Fig11",
        "p3 Table1"
      ],
      "assessment": "Fig6 caption says abiotic for tests9/10/11 although Table1 says biotic. Fig8 caption lists3/4/5/9/11/12, graph legend3/8/9/4/10/13/14. Fig9 caption identifies abiotic6 and biotic13; legend and text identify5 and11, and Table1 calls13 abiotic synthetic. Fig11 caption8/10/11/12/13, legend7/9/10/11/14, text attributes near-loss to12; legend labels7 at23 C while Table1 gives21 C. No authoritative remap or digitization of disputed traces."
    },
    {
      "id": "kinetic-order",
      "locators": [
        "pp3–4 Eqs6–9",
        "p4 Fig2 and Table2",
        "p4 section3.3"
      ],
      "assessment": "Section3.2 derives zero-order at high ferric concentration and first-order at low; Fig2 labels7g/L first-order and2g/L zero-order, and Table2/section3.3 retain opposing assignments. Printed labels preserved; not corrected by inference."
    },
    {
      "id": "copper-accounting",
      "locators": [
        "p2 sections2.1–2.4",
        "p4 section3.2",
        "p7 fermenter-rate paragraph"
      ],
      "assessment": "Methods gives 16g/L Cu and1g/L Al in fermenter feed, inoculum10% or100%, while the rate paragraph gives16.5g/L Cu/3.5g/L Al. No arm-specific initial dissolved Cu, inoculum subtraction, withdrawn sample volumes, acid addition volumes or tabulated residue-Cu masses found in the complete PDF. Daily sampling, evaporation replacement and analysis of terminal filtrate/residue are stated but do not close a Cu balance. Zero-initial-Cu model assumption does not establish measured zero Cu."
    },
    {
      "id": "acid",
      "locators": [
        "p4 Table2",
        "p7 Eq11",
        "p8 section3.7 and conclusion"
      ],
      "assessment": "Test11 measured acid0.79mol/molCu in Table2/section3.7 versus0.93 in conclusion. Test10/test4 values1.21/1.49 remain source-reported at nominal90% endpoint, not corrected stoichiometry. Eq11 uses initial metallic Cu minus half initial FeIII, over final CuII. Test13/14 stoichiometric entries1.83/0.21 are preserved without reverse-solving missing inventories."
    },
    {
      "id": "controls-and-null",
      "locators": [
        "p2 section2.3",
        "pp3–4 Tables1–2",
        "pp5–6 section3.5",
        "p7 section3.6"
      ],
      "assessment": "Thymol is stated for all abiotic tests, including inoculated3/4/13, but dose/direct-chemistry control absent. Replicate counts and uncertainty bars are not specified. Authors explicitly allow measurement error as explanation for small high-Fe benefit. Synthetic13/14 have equal32h endpoint and151/149 rates with different initialFeIII0.7/1.2; do not merge with cable-feed evidence. Test12 is nominalbiotic50C but authors state no detected bacteria/no biological mechanism."
    }
  ],
