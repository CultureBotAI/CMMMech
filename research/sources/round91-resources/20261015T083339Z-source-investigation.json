  "claims": [
    {
      "claim": "Distinct real secondary feed",
      "locators": [
        "§2.1 p2"
      ],
      "assessment": "Low-density fraction from knife-milled ELV cable, after upstream air classification and vibrating pneumatic table. 4.9%Cu/0.6%Al, mainly plastics and liberated wires below5mm. Separate from WPCB, elemental Cu and unseparated shredder residue."
    },
    {
      "claim": "Qualified culture comparison",
      "locators": [
        "§2.2–2.4 p2",
        "Table1 p3",
        "Table2 p4",
        "§3.5/Fig7 p5"
      ],
      "assessment": "Mixed culture initially source-named A.ferrooxidans, Leptospirillum ferrooxidans and A.thiooxidans; no accession/strain or final community assay. A.ferrooxidans predominance is source-reported, not independently quantified. No community CURIE is invented. Nominal9%pulp,45–55g/450–550mL,0.5Lreactor,700rpm,pH1.9; real tests4/10 both35C,1.9g/LFeIII,10%inoculum,3mL/minair. Source90%endpoint times69/50h and rates65/102mg/L/h; no replication/significance. Thymol dose/control effects unresolved."
    },
    {
      "claim": "Denominator and added-metal uncertainty",
      "locators": [
        "§2.2–2.3 p2",
        "§3.2 pp3–4",
        "§3.5 pp6–7"
      ],
      "assessment": "Culture adapted in16g/LCu+1g/LAl medium; separate rate passage instead16.5g/LCu+3.5g/LAl. Reaction modeling assumes zero initial dissolvedCu. Source does not unambiguously document inoculum-Cu subtraction or closed cable-specific balance; normalized extraction is author-reported, not independent feed recovery. No isolated-product claim."
    },
    {
      "claim": "Negative and chemical comparisons",
      "locators": [
        "§3.4–3.6",
        "Figs3–13",
        "Tables1–2"
      ],
      "assessment": "Substantial ferric chemical dissolution; syntheticCu/Al/SiO2 tests13/14 both32h to90%, doses0.7/1.2g/LFeIII not matched; not actualfeed evidence. No bacteria detected according to50C test12 text, thus exclude microbial50C outcome. Ferric regeneration late/slow and low enhancement acknowledged by authors."
    },
    {
      "claim": "Source contradictions",
      "locators": [
        "Fig8/9 p6",
        "Fig11 p7",
        "Table2 p4",
        "§3.7/Conclusion p8"
      ],
      "assessment": "Fig9 caption6/13 vs legend+text5/11; Fig8caption versuslegend different tests; Fig11caption/legend/text conflict, no reassignedcellcounts. Acid test11Table2/§3.7 .79 vsconclusion .93. Kinetic order explanation§3.3 reverses order labels versuspreceding model discussion/table. Do not infer corrected measurement or unique rate mechanism."
    }
  ],
