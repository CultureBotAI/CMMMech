  "scientific_findings": [
    {
      "locator": "Methods 2.1; Table 1",
      "finding": "The Austrian BOF slag was dried at 22 degrees C and sieved to 0.25-0.5 mm; it is distinct from the 2018 UK experimental feed. The mg/g table describes this sample, not global BOF composition."
    },
    {
      "locator": "Methods 2.2 and DSMZ DSM 583 catalogue",
      "finding": "The paper labels DSM 583 as ferridurans; the catalogue displays ferrooxidans. The source-specific culture name and accession are retained without a definitive species CURIE."
    },
    {
      "locator": "Methods 2.3 and Figure 3",
      "finding": "Biological duplicate flasks have uninoculated-medium controls but substantially different endpoint pH. DSM 504 Al is negligible; DSM 583 V is near the abiotic control. Media and initial acidity differ between cultures."
    },
    {
      "locator": "Methods 2.4; Figure 4; Table 2",
      "finding": "One reactor is described per organism; repeated samples are not independent reactor replicates. Two-thirds suspension replacement leaves carryover. Higher DSM 504 acid consumption and higher-loading DSM 583 V below the chemical control prevent universal-advantage claims. Figure 4 bars do not support blanket Al >80% and Mn >50% prose."
    },
    {
      "locator": "Methods 2.3 displayed equation, Methods 2.4 and Table 2",
      "finding": "The printed background correction was inspected; raw medium/inoculum concentrations and cycle carryover/volume accounting are unavailable. Table 2 uses an 18 M acid reporting basis versus 2 M dosing in Methods; conversion details are unreported. Yields were not recalculated."
    },
    {
      "locator": "Methods 2.7-2.8; Figure 5",
      "finding": "Downstream assays use synthetic SMS-AT/AF, not real bioleachates. Assigned Fe valence and salt matrices differ. Filtrate depletion after 45 hours does not establish product purity or actual-effluent recovery."
    },
    {
      "locator": "Page 10 data statement",
      "finding": "ESI is mentioned but no artifact was inspected; bounded main, s1 and status publisher routes returned HTTP 403 or were inaccessible. Complete supporting-data availability is not claimed."
    }
  ],
