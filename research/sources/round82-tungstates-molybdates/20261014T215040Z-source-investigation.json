  "accepted": [
    {
      "slug": "stolzite",
      "authority": "IMA September2026 p1 definitions,p206:Pb(WO4),G,1845",
      "primary": "Kiseleva2008 New Data on Minerals43:13\u201322",
      "inspection": "Full extracted text and original pages13,18\u201322 including Figures3\u20134 visually inspected in this round. Prior round47 inspected all10pages; that earlier work is not represented as new full-page visual inspection.",
      "positive_basis": "Distinct W-dominant mineral assignment, reported microprobe composition Pb(W0.74Mo0.26)O4, fracture/cavity textures in galena.",
      "limits": [
        "No crystal-structure analysis of these tiny grains; composition and optical/textural assignment do not resolve every possible structural question.",
        "Supergene formation inferred from associations; no cultures, controlled reaction, extraction yield or industrial recovery.",
        "Same publication as existing dzhalindite record, distinct phase arm and no independent replication claim.",
        "Chillagite not minted as distinct owner; year1845 not fabricated as unique accession."
      ]
    },
    {
      "slug": "powellite",
      "authority": "IMA September2026 p1 definitions,p177:Ca(MoO4),G,1891",
      "primary": "Sidorenko2008 New Data on Minerals43:23\u201330",
      "inspection": "Complete eight-page original with all page graphics visually inspected; no numbered tables. Nine figures announced, with several graphic captions absent or displaced in this official layout; graph assignment uses page text and numbered references, not invented captions.",
      "positive_basis": "Crystalline CaMoO4 in uranophane-beta assemblage is supported by powder diffraction and infrared characterization.",
      "limits": [
        "The chemically similar uramarsite-associated arm is optically isotropic and X-ray amorphous; metamict origin is author interpretation and not a separate directly refined crystalline phase.",
        "Page29 both describes retained diffraction and says disappearance of anisotropy/diffraction for the silicate arm; unresolved internal inconsistency, not silently corrected.",
        "Radiation origin and exposure chronology are inferred, not controlled irradiations or direct dosimetry.",
        "Thermal analysis of uranate-associated amorphous material not performed for lack of material (p29); crystalline-arm heating must not be transferred.",
        "Bota-Burum specimens do not establish resource grade, extraction yield, microbial activity or industrial deployment."
      ]
    }
  ],
