+def check_postmerge_receipt(cfg, commit, verification, coverage, digest, coverage_helper):
+    """Require actual successful postmerge gates bound to the reviewed inputs."""
+    base = cfg['base']
+    assert cfg['status'] == FINAL_CONFIG_STATUS
+    assert commit['exit_code'] == 0 and commit['base'] == base
+    assert verification['mode'] == 'postmerge' and verification['exit_code'] == 0
+    assert verification['trusted_base'] == base
+    assert verification['topic_head'] == commit['head']
+    assert verification['expected_tree'] == commit['tree']
+    assert verification['config_sha256'] == commit['config_sha256']
+    assert verification['helper_sha256'] == commit['verification_helper_sha256']
+    assert digest(coverage_helper) == commit['coverage_helper_sha256']
+    assert digest(verification['log']) == verification['log_sha256']
+    assert digest(verification['coverage']['path']) == verification['coverage']['sha256']
+    assert coverage['passed'] is True
+    assert coverage['root'] == verification['clone']
+    assert verification['counts'] == cfg['counts']
+    assert all(coverage[key] == value for key, value in cfg['counts'].items())
+    clone = verification['clone']
+    required = [
+        ['uv', 'run', '--locked', 'cmmmech', 'validate', '--require-records'],
+        ['uv', 'run', '--locked', 'cmmmech', 'validate-history', '--base', base],
+        ['just', 'review-check', '--base', base, '--require-reviews'],
+        [clone + '/.venv/bin/python', coverage_helper, '--clone', clone,
+         '--output', verification['coverage']['path']],
+    ]
+    commands = verification['commands']
+    assert commands and all(row['exit_code'] in row['allowed_exit_codes'] for row in commands)
+    for command in required:
+        matches = [row for row in commands if row['command'] == command]
+        assert len(matches) == 1
+        assert matches[0]['exit_code'] == 0 and matches[0]['cwd'] == clone
+
+
+def check_cleanup_origin(origin):
+    assert origin == EXPECTED_ORIGIN

